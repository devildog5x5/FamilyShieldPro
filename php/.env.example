APP_SECRET=change-me-to-a-long-random-string
BASE_URL=https://sandbox.familyshieldpro.com
SUPPORT_EMAIL=CustomerService@FamilyShieldPro.com
# Shown on the public site only if set to a real number (never XXX placeholders)
CONTACT_PHONE=
SHOW_DEMO_LOGIN=1
OPERATOR_EMAIL=CustomerService@FamilyShieldPro.com
OPERATOR_PASSWORD=
# Public /healthz stays small. Set 1 only on a private operator network.
HEALTHZ_DETAILS=0

# Mail (optional)
MAIL_FROM=
MAIL_FROM_NAME=Family Shield Pro
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=0

# Stripe (optional). Without keys, choosing a plan only saves it on the circle.
# Test mode: use sk_test_ / pk_test_ / price_ / buy.stripe.com/test_ values.
# See STRIPE.md. powershell -File .\deploy\setup_stripe_test.ps1 creates test prices and Payment Links.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PAYMENT_LINK_MONTHLY=
STRIPE_PAYMENT_LINK_YEARLY=
STRIPE_WEBHOOK_SECRET=

# Help chat (optional). xAI Grok — same model family as Cursor Grok, but this site needs its own key.
# Create a key at https://console.x.ai (Cursor login does not supply this). Paste into Hostinger public_html/.env.
XAI_API_KEY=
# Optional. Default grok-4.6
GROK_MODEL=grok-4.6
