APP_SECRET=change-me-to-a-long-random-string
# Live site. sandbox.familyshieldpro.com now returns 404 — do not use it.
BASE_URL=https://familyshieldpro.com
# Search console (optional). Paste the content code only, or the whole meta tag. Blank omits the tag.
# Google Search Console → HTML tag → content value of google-site-verification
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → HTML meta tag → content value of msvalidate.01
BING_SITE_VERIFICATION=
# Outbound mail only. The site never shows this address. The public line is Inquiries Text First Then Call: 801.319.1061.
SUPPORT_EMAIL=CustomerService@FamilyShieldPro.com
# Not shown on the site. The public line is Inquiries Text First Then Call: 801.319.1061.
CONTACT_PHONE=
# Demo sign-in is a normal writable circle, not a read-only sandbox.
# Leave this off. familyshieldpro.com never prints the demo email or password, even if this is 1.
# Set 1 only on a private copy such as http://127.0.0.1:8080.
SHOW_DEMO_LOGIN=0
OPERATOR_EMAIL=CustomerService@FamilyShieldPro.com
OPERATOR_PASSWORD=
# Public /healthz stays small. Set 1 only on a private operator network.
HEALTHZ_DETAILS=0

# Mail (optional)
MAIL_FROM=
MAIL_FROM_NAME=Family Shield Pro
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=0

# Stripe (optional). Without keys, choosing a plan only saves it on the circle.
# Test mode: use sk_test_ / pk_test_ / price_ / buy.stripe.com/test_ values.
# See STRIPE.md. powershell -File .\deploy\setup_stripe_test.ps1 creates test prices and Payment Links.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PAYMENT_LINK_MONTHLY=
STRIPE_PAYMENT_LINK_YEARLY=
STRIPE_WEBHOOK_SECRET=

# Help chat (optional). xAI Grok — same model family as Cursor Grok, but this site needs its own key.
# Create a key at https://console.x.ai (Cursor login does not supply this). Paste into Hostinger public_html/.env.
XAI_API_KEY=
# Optional. Default grok-4.6
GROK_MODEL=grok-4.6
