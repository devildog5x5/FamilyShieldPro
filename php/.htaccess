RewriteEngine On
RewriteBase /
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
AddType image/webp .webp
AddType text/plain .txt

# One public address. Hostinger already sends http to https.
RewriteCond %{HTTP_HOST} ^www\.familyshieldpro\.com$ [NC]
RewriteRule ^index\.php/?$ https://familyshieldpro.com/ [R=301,L,QSA]
RewriteCond %{HTTP_HOST} ^www\.familyshieldpro\.com$ [NC]
RewriteRule ^(.+)/$ https://familyshieldpro.com/$1 [R=301,L,QSA]
RewriteCond %{HTTP_HOST} ^www\.familyshieldpro\.com$ [NC]
RewriteRule ^ https://familyshieldpro.com%{REQUEST_URI} [R=301,L]
RewriteRule ^index\.php/?$ / [R=301,L,QSA]
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [R=301,L,QSA]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "(?i)\.(css|js|webp|png|jpe?g|gif|ico|svg|mp4|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# Never serve source archives, build scripts, secrets, or dev files.
<FilesMatch "(?i)\.(zip|ps1|sql|bak|log|sh|sqlite|db|md|ya?ml|ini|dist|apk|exe|msi|dmg|7z|phar|tgz|gz)$">
  Require all denied
</FilesMatch>
<FilesMatch "(?i)^\.(env|git|gitignore|gitattributes|htpasswd)">
  Require all denied
</FilesMatch>
<FilesMatch "(?i)^(composer\.(json|lock)|package(-lock)?\.json|Dockerfile|Makefile)$">
  Require all denied
</FilesMatch>

RewriteRule "(^|/)\.(env|git)" - [F,L]
RewriteRule "(^|/)(composer\.(json|lock)|package(-lock)?\.json|Dockerfile|Makefile)$" - [F,L]
RewriteRule \.(zip|ps1|sql|bak|log|sh|sqlite|db|md|ya?ml|ini|dist|apk|exe|msi|dmg|7z|phar|tgz|gz)$ - [F,L]
RewriteRule ^(\.env|bootstrap\.php)$ - [F,L]
RewriteRule ^(src|views|data)(/|$) - [F,L]
RewriteRule \.db$ - [F,L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteRule ^ index.php [QSA,L]
